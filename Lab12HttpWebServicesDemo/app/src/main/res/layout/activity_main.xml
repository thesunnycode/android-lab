<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header: app, student and the lab topic -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="#C7D8EE"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="#26FFFFFF"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/student"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:checkedButton="@id/modeGet"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/modeGet"
                    style="@style/ModeButton"
                    android:text="@string/mode_get" />

                <Button
                    android:id="@+id/modePost"
                    style="@style/ModeButton"
                    android:text="@string/mode_post" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- GET panel -->
            <LinearLayout
                android:id="@+id/getPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cityLayout"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="@string/city_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/city"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fetch"
                        style="@style/Widget.Material3.Button.Icon"
                        android:layout_width="56dp"
                        android:layout_height="54dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/fetch"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_search"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>

                <TextView
                    style="@style/Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/quick_picks" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cities"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <!-- Forecast result -->
                <LinearLayout
                    android:id="@+id/weatherCard"
                    style="@style/Card"
                    android:background="@drawable/bg_weather"
                    android:visibility="gone">

                    <TextView
                        style="@style/Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/now" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cityName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#13294B"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cityRegion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#5B6B82"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/temperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="#13294B"
                                android:textSize="44sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/condition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#2F6DAE"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="58sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/feelsLike"
                            style="@style/Stat" />

                        <TextView
                            android:id="@+id/humidity"
                            style="@style/Stat" />

                        <TextView
                            android:id="@+id/wind"
                            style="@style/Stat" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/advice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="#FFF4E5"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:textColor="#8A4B08"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/five_day" />

                    <LinearLayout
                        android:id="@+id/days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <!-- POST panel -->
            <LinearLayout
                android:id="@+id/postPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/Card"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkin_title"
                        android:textColor="#13294B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/checkin_body"
                        android:textColor="#5B6B82"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameLayout"
                        style="@style/Field"
                        android:hint="@string/name_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            android:text="@string/default_name" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/usnLayout"
                        style="@style/Field"
                        android:hint="@string/usn_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/usn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLines="1"
                            android:text="@string/default_usn" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/destinationLayout"
                        style="@style/Field"
                        android:hint="@string/destination_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/destination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSend"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:text="@string/default_destination" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/send"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- Server's reply to the POST -->
                <LinearLayout
                    android:id="@+id/receiptCard"
                    style="@style/Card"
                    android:background="@drawable/bg_receipt"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/receiptTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#14532D"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/receiptBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#1E3A2A"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Errors from either panel -->
            <LinearLayout
                android:id="@+id/errorCard"
                style="@style/Card"
                android:background="@drawable/bg_error"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9A2A12"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/errorBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#6B2A1C"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- HTTP inspector: the raw exchange behind whatever is on screen -->
            <LinearLayout
                style="@style/Card"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/inspector" />

                    <TextView
                        android:id="@+id/method"
                        style="@style/Pill"
                        android:backgroundTint="#E3F0FC"
                        android:textColor="#13294B"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/statusCode"
                        style="@style/Pill"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackCornerRadius="4dp" />

                <TextView
                    android:id="@+id/requestUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="@string/inspector_idle"
                    android:textColor="#2F3E55"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textIsSelectable="false"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/timing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#5B6B82"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/requestLabel"
                    style="@style/Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/request_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/requestBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_code"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:textColor="#FFD7A8"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/responseLabel"
                    style="@style/Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/response_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/responseBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_code"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="14"
                    android:padding="12dp"
                    android:textColor="#A7F3D0"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <!-- Solid strip behind the status bar so scrolled content never shows through it. -->
    <View
        android:id="@+id/statusScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#13294B" />
</FrameLayout>
