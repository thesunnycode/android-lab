<resources>
    <style name="Theme.TripCast" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#13294B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#F26B4F</item>
        <item name="colorPrimaryContainer">#E3F0FC</item>
        <item name="colorOnPrimaryContainer">#13294B</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOutline">#B8C6D9</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#F1F5FA</item>
    </style>

    <style name="Eyebrow">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#5B6B82</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Stat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#13294B</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">#FFFFFF</item>
    </style>


    <style name="ModeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="strokeColor">#13294B</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
