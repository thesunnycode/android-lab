<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_hero">

    <!-- Decorative circles, matching the login screen's design system -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.45"
        android:background="@drawable/circle_decor_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-70dp"
        android:layout_marginEnd="-70dp" />

    <View
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:alpha="0.4"
        android:background="@drawable/circle_decor_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-50dp" />

    <View
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:alpha="0.5"
        android:background="@drawable/circle_decor_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginStart="24dp" />

    <!-- Centered content -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/circle_avatar"
        android:gravity="center"
        android:text="👤"
        android:textSize="42sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tvAvatar"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You're logged in successfully"
        android:textSize="14sp"
        android:textColor="@color/subtitle_lavender"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintBottom_toTopOf="@id/btnLogout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:minWidth="200dp"
        android:text="Log out"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@color/indigo_accent"
        android:background="@drawable/bg_button_rounded_white"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
