<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Gradient hero panel -->
    <View
        android:id="@+id/heroBackground"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_gradient_hero"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative circles -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:alpha="0.5"
        android:background="@drawable/circle_decor_light"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintEnd_toEndOf="@id/heroBackground"
        app:layout_constraintBottom_toBottomOf="@id/heroBackground"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-50dp" />

    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:alpha="0.45"
        android:background="@drawable/circle_decor_dark"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintStart_toStartOf="@id/heroBackground"
        android:layout_marginTop="40dp"
        android:layout_marginStart="-30dp" />

    <TextView
        android:id="@+id/tvHeroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TourPlanner"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="44dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan your next trip"
        android:textColor="@color/circle_light"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
        app:layout_constraintStart_toStartOf="@id/tvHeroTitle"
        android:layout_marginTop="6dp" />

    <!-- White card with rounded top corners, overlapping the hero panel -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_top_rounded"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="150dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Traveler Name"
                android:textSize="12sp"
                android:textColor="@color/hint_gray"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTravelerName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter your name"
                android:textColorHint="@color/hint_gray"
                android:textColor="@color/text_primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_field_rounded"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destination"
                android:textSize="12sp"
                android:textColor="@color/hint_gray"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Where do you want to go?"
                android:textColorHint="@color/hint_gray"
                android:textColor="@color/text_primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_field_rounded"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Number of Days"
                android:textSize="12sp"
                android:textColor="@color/hint_gray"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDays"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. 5"
                android:textColorHint="@color/hint_gray"
                android:textColor="@color/text_primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_field_rounded"
                android:inputType="number"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destination Category"
                android:textSize="12sp"
                android:textColor="@color/hint_gray"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="4dp">

                <RadioButton
                    android:id="@+id/rbAdventure"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/chip_adventure_bg"
                    android:textColor="@color/chip_adventure_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="Adventure" />

                <RadioButton
                    android:id="@+id/rbHeritage"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/chip_heritage_bg"
                    android:textColor="@color/chip_heritage_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="Heritage" />

                <RadioButton
                    android:id="@+id/rbRelaxation"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/chip_relaxation_bg"
                    android:textColor="@color/chip_relaxation_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="Relaxation" />
            </RadioGroup>

            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="1dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
