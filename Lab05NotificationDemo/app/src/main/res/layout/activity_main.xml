<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Gradient hero panel -->
    <View
        android:id="@+id/heroBackground"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_gradient_hero"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative circles -->
    <View
        android:id="@+id/circleLarge"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:alpha="0.55"
        android:background="@drawable/circle_decor_light"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintEnd_toEndOf="@id/heroBackground"
        app:layout_constraintBottom_toBottomOf="@id/heroBackground"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-60dp" />

    <View
        android:id="@+id/circleMedium"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:alpha="0.5"
        android:background="@drawable/circle_decor_dark"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintStart_toStartOf="@id/heroBackground"
        android:layout_marginTop="60dp"
        android:layout_marginStart="-30dp" />

    <View
        android:id="@+id/circleSmall"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0.6"
        android:background="@drawable/circle_decor_light"
        app:layout_constraintBottom_toBottomOf="@id/heroBackground"
        app:layout_constraintStart_toStartOf="@id/heroBackground"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="40dp" />

    <!-- Screen title on the hero panel -->
    <TextView
        android:id="@+id/tvHeroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notifications"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="48dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/tvHeroSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lab 05 — Notification demo"
        android:textColor="@color/subtitle_lavender"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
        app:layout_constraintStart_toStartOf="@id/tvHeroTitle"
        android:layout_marginTop="6dp" />

    <!-- White card with rounded top corners, overlapping the hero panel -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_top_rounded"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="220dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compose a notification"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/indigo_text"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textSize="12sp"
            android:textColor="@color/hint_gray"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter notification title"
            android:textColorHint="@color/hint_gray"
            android:textColor="@color/indigo_text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_field_rounded"
            android:inputType="text"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textSize="12sp"
            android:textColor="@color/hint_gray"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter notification message"
            android:textColorHint="@color/hint_gray"
            android:textColor="@color/indigo_text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_field_rounded"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnNotify"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Send notification"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_rounded"
            app:backgroundTint="@null"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnNotifyExpandable"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Send expandable notification"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/indigo_accent"
            android:background="@drawable/bg_button_outlined"
            app:backgroundTint="@null"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pull down the status bar to see the notification. Tap it to open the details screen."
            android:textSize="13sp"
            android:textColor="@color/hint_gray"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
