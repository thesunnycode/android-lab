<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps no data of its own: contacts live in the Contacts Provider. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
