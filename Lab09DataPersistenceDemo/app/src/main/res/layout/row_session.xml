<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
    android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp">
    <TextView android:id="@+id/sessionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#19392E" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/sessionDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#52615A" android:textSize="11sp" android:letterSpacing="0.05" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/editSession"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/edit" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deleteSession"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/delete" android:textColor="#A13732" />
    </LinearLayout>
</LinearLayout>
