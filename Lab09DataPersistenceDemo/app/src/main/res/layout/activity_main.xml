<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/experiment_label" android:textColor="#175C49" android:textSize="11sp"
            android:letterSpacing="0.12" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/app_name" android:textColor="#19392E"
            android:textSize="36sp" android:fontFamily="serif" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/tagline" android:textColor="#52615A" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_heading" android:textColor="#19392E" android:textStyle="bold" android:textSize="19sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/profile_hint" android:textColor="#52615A" android:textSize="12sp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="@string/student_name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPersonName" android:maxLength="80" android:maxLines="1"
                    android:singleLine="true" android:importantForAutofill="no" android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:hint="@string/usn">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/usnInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapCharacters" android:maxLength="24" android:maxLines="1"
                    android:singleLine="true" android:importantForAutofill="no" android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/saveProfile"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:minHeight="48dp" android:text="@string/save_profile" />
            <TextView android:id="@+id/profileStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_status" android:padding="12dp"
                android:text="@string/no_profile" android:textColor="#175C49" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="@string/records_heading" android:textColor="#19392E" android:textStyle="bold" android:textSize="21sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/records_hint" android:textColor="#52615A" android:textSize="12sp" />
        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="#175C49" android:textStyle="bold" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/addSession"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/add_session" />
        <TextView android:id="@+id/recordsStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#52615A" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/emptySessions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="20dp"
            android:text="@string/empty_sessions" android:textColor="#52615A" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        <LinearLayout android:id="@+id/sessionList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/persistence_note" android:textColor="#52615A"
            android:textSize="11sp" android:lineSpacingExtra="5dp" />
    </LinearLayout>
</ScrollView>
