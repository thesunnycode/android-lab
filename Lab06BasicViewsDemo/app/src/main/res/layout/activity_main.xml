<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Gradient hero panel -->
    <View
        android:id="@+id/heroBackground"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_gradient_hero"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative circles -->
    <View
        android:id="@+id/circleLarge"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:alpha="0.55"
        android:background="@drawable/circle_decor_light"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintEnd_toEndOf="@id/heroBackground"
        app:layout_constraintBottom_toBottomOf="@id/heroBackground"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-60dp" />

    <View
        android:id="@+id/circleMedium"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:alpha="0.5"
        android:background="@drawable/circle_decor_dark"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintStart_toStartOf="@id/heroBackground"
        android:layout_marginTop="50dp"
        android:layout_marginStart="-30dp" />

    <!-- Screen title on the hero panel -->
    <TextView
        android:id="@+id/tvHeroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Basic Views"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="48dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/tvHeroSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lab 06 — Basic Views demo"
        android:textColor="@color/subtitle_lavender"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
        app:layout_constraintStart_toStartOf="@id/tvHeroTitle"
        android:layout_marginTop="6dp" />

    <!-- White card with rounded top corners, overlapping the hero panel -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_top_rounded"
        app:layout_constraintTop_toTopOf="@id/heroBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="170dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student registration form"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/indigo_text"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textSize="12sp"
                    android:textColor="@color/hint_gray"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter your name"
                    android:textColorHint="@color/hint_gray"
                    android:textColor="@color/indigo_text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_field_rounded"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textSize="12sp"
                    android:textColor="@color/hint_gray"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rgGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <RadioButton
                        android:id="@+id/rbMale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Male"
                        android:textColor="@color/indigo_text"
                        android:buttonTint="@color/indigo_accent"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbFemale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Female"
                        android:textColor="@color/indigo_text"
                        android:buttonTint="@color/indigo_accent"
                        android:layout_marginStart="20dp" />

                    <RadioButton
                        android:id="@+id/rbOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other"
                        android:textColor="@color/indigo_text"
                        android:buttonTint="@color/indigo_accent"
                        android:layout_marginStart="20dp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course"
                    android:textSize="12sp"
                    android:textColor="@color/hint_gray"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spCourse"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_field_rounded"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:entries="@array/course_options"
                    android:layout_marginBottom="18dp" />

                <CheckBox
                    android:id="@+id/cbNewsletter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscribe to newsletter"
                    android:textSize="13sp"
                    android:textColor="@color/indigo_text"
                    android:buttonTint="@color/indigo_accent"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:id="@+id/tvExperienceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experience: 0 yrs"
                    android:textSize="12sp"
                    android:textColor="@color/hint_gray"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/sbExperience"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="0"
                    android:progressTint="@color/indigo_accent"
                    android:thumbTint="@color/indigo_accent"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Submit"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_rounded"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field_rounded"
                    android:padding="16dp"
                    android:textSize="13sp"
                    android:textColor="@color/indigo_text"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
