<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="232dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp"
    android:background="@drawable/bg_place_card" android:clickable="true" android:elevation="3dp"
    android:focusable="true" android:foreground="?attr/selectableItemBackground" android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/category" style="@style/Eyebrow" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/bg_pill" android:paddingStart="8dp"
            android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:textColor="#FFFFFF" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/stopBadge" style="@style/Eyebrow" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#B5741A" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/placeName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:ellipsize="end" android:fontFamily="serif" android:maxLines="1"
        android:textColor="#1F3D2E" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/placeNote" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:ellipsize="end" android:lines="2" android:textColor="#7A6A55"
        android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/placeDistance" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#9A8A76" android:textSize="11sp" android:maxLines="1"
            android:ellipsize="end" />
        <com.google.android.material.button.MaterialButton android:id="@+id/toggleStop"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="40dp" android:minWidth="0dp" android:paddingStart="12dp"
            android:paddingEnd="14dp" android:text="@string/add_stop" android:textSize="12sp" app:icon="@drawable/ic_add"
            app:iconPadding="4dp" app:iconSize="16dp" />
    </LinearLayout>
</LinearLayout>
